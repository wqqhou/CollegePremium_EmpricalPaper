# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local system files and existing archive
.DS_Store
archive/

# LaTeX compilation intermediates (including SyncTeX busy files)
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex*
*.toc
*.lof
*.lot
*.bbl
*.blg
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.xdv
*.dvi

# Compiled reports and the figure generated by plot_education_premia.py
# Keep source/reference PDFs elsewhere and manually maintained table .tex files.
/reports/*.pdf
/reports/figures/education_premia.pdf
/reports/figures/education_premia.png
/reports/figures/education_premia_figure_metadata.json

# Rebuilt by the data-processing, regression, and audit scripts
/data/processed/
/data/derived/
/outputs/diagnostics/
/outputs/regression/

# Generated sensitivity outputs; retain downloaded weights and revision records
/outputs/sensitivity/*/processed/
/outputs/sensitivity/*/diagnostics/
/outputs/sensitivity/*/regression/
